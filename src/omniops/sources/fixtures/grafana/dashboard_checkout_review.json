{
  "dashboard": {
    "id": 7,
    "editable": true,
    "schemaVersion": 41,
    "version": 1,
    "refresh": "",
    "timezone": "browser",
    "tags": [],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "enable": true,
          "titleFormat": "{{ service_name }} {{ version }}",
          "textFormat": "{{ message }}",
          "expr": "{service_name=\"checkout\"} | json | event=\"deploy\""
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "P95 Latency",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"checkout\"}[$__rate_interval])))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Peak Memory",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          }
        },
        "targets": [
          {
            "expr": "max(max_over_time(process_resident_memory_bytes{job=\"checkout\"}[$__range]))",
            "instant": true,
            "range": false,
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Logs",
        "type": "logs",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "expr": "{service_name=\"checkout\"} | json | level=\"error\"",
            "refId": "A"
          }
        ]
      }
    ],
    "uid": "checkout-review",
    "title": "Checkout Review"
  },
  "meta": {
    "isStarred": false,
    "url": "/d/checkout-review/checkout-review",
    "folderId": 0,
    "folderUid": "",
    "slug": "checkout-review"
  }
}
