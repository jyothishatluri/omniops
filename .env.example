# OmniOps environment. Copy to .env (gitignored) and fill in what you use; never commit secrets.
# Lines marked [secret] hold credentials. A data source is enabled only when its required variables
# are set (OmniOps lists sources that are not configured by variable NAME, never by value).
# The authoritative list per source is the `env:` block of src/omniops/sources/manifests/<source>.yaml.

# =============================================================================================
# LLM (Meta Model API, OpenAI-compatible; https://api.meta.ai/v1)
# =============================================================================================
MODEL_API_KEY=                          # [secret] Meta Model API key
# OMNIOPS_LLM_API_KEY_ENV=MODEL_API_KEY # name of the variable that holds the key
# OMNIOPS_LLM_BASE_URL=https://api.meta.ai/v1
# OMNIOPS_LLM_PROTOCOL=responses        # responses | chat (Chat Completions for other compatible endpoints)
# OMNIOPS_MODEL_HEAVY=muse-wonder-1.0   # model per tier: heavy | mid | fast
# OMNIOPS_MODEL_MID=muse-spark-1.3
# OMNIOPS_MODEL_FAST=muse-spark-1.3
# OMNIOPS_ALLOW_CONTRIBUTOR_MODELS=0    # 1 allows contributor (provider-may-train) models: never with ops data

# =============================================================================================
# Slack (create the app from slack_app_manifest.yaml)
# =============================================================================================
SLACK_BOT_TOKEN=                        # [secret] xoxb-... Bot User OAuth Token
SLACK_APP_TOKEN=                        # [secret] xapp-... App-level token with connections:write (Socket Mode)
SLACK_USER_TOKEN=                       # [secret] optional xoxp-... user token for Slack APIs bots cannot call (search)
OMNIOPS_ALERT_CHANNELS=                 # comma-separated channel ids (C0123ABC) or names (#alerts) to watch

# =============================================================================================
# OmniOps runtime (wall-clock budgets in seconds)
# =============================================================================================
# OMNIOPS_CONFIG=omniops.yaml           # optional source instances file (several instances of one source)
# OMNIOPS_MANIFEST_DIRS=                # extra manifest directories (path-separated)
# OMNIOPS_INVESTIGATION_BUDGET_S=780
# OMNIOPS_REPORT_RESERVE_S=90
# OMNIOPS_REPORT_CALL_S=900
# OMNIOPS_SPECIALIST_BUDGET_S=240
# OMNIOPS_CHAT_BUDGET_S=300
# OMNIOPS_WATCHDOG_GRACE_S=120          # absolute watchdog = budget + grace (report call: + REPORT_CALL - RESERVE)
# OMNIOPS_DEEPENING_ROUNDS=3
# OMNIOPS_SPECIALISTS=code_change,prior_incidents,customer_impact,dependency,infrastructure
# OMNIOPS_SHADOW_AGENTS=
# OMNIOPS_WRITE_MODE=stage              # stage (human approval in Slack) | deny | auto (benchmarks only)
# OMNIOPS_MEMORY_PATH=.omniops/memory.db
# OMNIOPS_CASE_DIR=.omniops/cases
# OMNIOPS_BENCHMARK_MODE=0
# OMNIOPS_TLS_VERIFY=true               # false only for self-signed lab endpoints
# OMNIOPS_DISPLAY_TZ=UTC                # IANA zone for times shown to people (e.g. America/Chicago)

# =============================================================================================
# Benchmarks (optional)
# =============================================================================================
# O11Y_SCENARIO_TIME_ISO=               # o11y-bench: the scenario clock (set by the harness)
# OMNIOPS_O11YBENCH_SOURCES=            # o11y-bench: override the source selection
# OMNIOPS_BENCH_TIMEOUT_S=540
# OMNIOPS_WHEEL=                        # o11y-bench: path to the omniops wheel to install in the task container
# ARENA_DIR=                            # Edge Delta AI SRE Arena checkout
# ARENA_CONTEXT=                        # kube context of the Arena cluster
# ARENA_PYTHON=                         # Python interpreter for the Arena's own scripts (default: this one)
# OMNIOPS_ARENA_CHANNEL=                # real Slack channel for --real-slack runs
# OMNIOPS_ARENA_POSTER_TOKEN=           # [secret] a second identity that posts launch messages (the bot ignores itself)
# OMNIOPS_ARENA_ALERT_TOKEN=            # [secret] another app's bot token that posts alerts (never OmniOps' own)
# OMNIOPS_ARENA_GRAFANA_POSTS=0
# OMNIOPS_ARENA_BRIDGE_PORT=8787
# OMNIOPS_ARENA_FAULT_REPO_ACCESS=0
# GITHUB_REPOS=                         # comma-separated owner/repo list for the Arena GitOps repos
# ANTHROPIC_API_KEY=                    # [secret] optional official o11y-bench judge
# OPENROUTER_API_KEY=                   # [secret] optional official Arena judge

# =============================================================================================
# Data sources (generated by scripts/gen_env_example.py from the manifests; a source is
# enabled when all of its uncommented variables are set)
# =============================================================================================

# --- Amazon Managed Service for Prometheus (amazon_prometheus) -------------------------------
# Workspace ID, e.g. ws-b226cc2a-a446-46a9-933a-ac50479a5568
AMP_WORKSPACE_ID=
# AWS region of the workspace, e.g. us-west-2 (host aps-workspaces.<region>.amazonaws.com)
AMP_REGION=

# --- AWS CloudTrail (event history) (cloudtrail) ---------------------------------------------
# Region whose event history to read, e.g. us-east-1. Global services (IAM, CloudFront, Route 53) log to us-east-1.
AWS_REGION=
# Optional endpoint override (VPC endpoint, FIPS https://cloudtrail-fips.<region>.amazonaws.com). 'auto' = https://cloudtrail.<region>.amazonaws.com
# AWS_ENDPOINT_URL_CLOUDTRAIL=auto
# Optional named profile; credentials come from the standard AWS chain (not read by templates).
# AWS_PROFILE=
# Optional static key (AWS credential chain)
# AWS_ACCESS_KEY_ID=
# Optional static secret (AWS credential chain)
# AWS_SECRET_ACCESS_KEY=
# Optional session token (AWS credential chain)
# AWS_SESSION_TOKEN=

# --- Amazon CloudWatch (metrics & alarms) (cloudwatch) ---------------------------------------
# Optional endpoint override (VPC interface endpoint, FIPS endpoint https://monitoring-fips.<region>.amazonaws.com, LocalStack). 'auto' = https://monitoring.<region>.amazonaws.com (.com.cn for cn-* regi
# AWS_ENDPOINT_URL_CLOUDWATCH=auto

# --- Amazon CloudWatch Logs (cloudwatch_logs) ------------------------------------------------
# Optional endpoint override (VPC endpoint, FIPS https://logs-fips.<region>.amazonaws.com, LocalStack). 'auto' = https://logs.<region>.amazonaws.com
# AWS_ENDPOINT_URL_CLOUDWATCH_LOGS=auto

# --- AWS X-Ray (xray) ------------------------------------------------------------------------
# Optional endpoint override (VPC endpoint, FIPS https://xray-fips.<region>.amazonaws.com, LocalStack). 'auto' = https://xray.<region>.amazonaws.com
# AWS_ENDPOINT_URL_XRAY=auto

# --- Argo CD (argocd) ------------------------------------------------------------------------
# Argo CD server URL incl. any --rootpath, e.g. https://argocd.example.com or http://localhost:8080 (port-forward). No trailing /api
ARGOCD_URL=
# API token (Authorization: Bearer). A role:readonly account token is enough: argocd account generate-token --account <name>
ARGOCD_TOKEN=
# Optional default Application namespace (apps-in-any-namespace); empty = the control-plane namespace / all enabled namespaces
# ARGOCD_APP_NAMESPACE=

# --- Confluence (confluence) -----------------------------------------------------------------
# Site URL, e.g. https://acme.atlassian.net (with or without /wiki). For OAuth 2.0 (3LO) or scoped API tokens use https://api.atlassian.com/ex/confluence/<cloudId>.
CONFLUENCE_URL=
# API token (id.atlassian.com > Security > API tokens) for basic auth, or an OAuth 2.0 access token when CONFLUENCE_AUTH=bearer. The same Atlassian API token works for Jira and Confluence on one site.
CONFLUENCE_API_TOKEN=
# Atlassian account email for basic auth (CONFLUENCE_AUTH=basic)
# CONFLUENCE_EMAIL=
# basic (email + API token, default) | bearer (OAuth 2.0 access token)
# CONFLUENCE_AUTH=basic

# --- Jira (jira) -----------------------------------------------------------------------------
# Site base URL, e.g. https://acme.atlassian.net (no trailing /rest). For OAuth 2.0 (3LO) or scoped API tokens use the gateway form https://api.atlassian.com/ex/jira/<cloudId> and set JIRA_UI_URL.
JIRA_URL=
# API token (id.atlassian.com > Security > API tokens) for basic auth, or an OAuth 2.0 access token when JIRA_AUTH=bearer. Read-only use: Browse projects permission is enough.
JIRA_API_TOKEN=
# Atlassian account email used with JIRA_API_TOKEN for basic auth (JIRA_AUTH=basic)
# JIRA_EMAIL=
# basic (email + API token, default) | bearer (OAuth 2.0 access token / service-account bearer token)
# JIRA_AUTH=basic
# Browser base for /browse links when JIRA_URL is the api.atlassian.com gateway, e.g. https://acme.atlassian.net
# JIRA_UI_URL=
# Site cloud id for the Jira Service Management Operations API (api.atlassian.com/jsm/ops/api/<cloudId>). Optional: when unset it is read from <site>/_edge/tenant_info on each JSM call.
# JIRA_CLOUD_ID=
# JQL clause that defines an incident ticket for jira_incidents and the incidents role
# JIRA_INCIDENT_JQL=issuetype = Incident

# --- Opsgenie (opsgenie) ---------------------------------------------------------------------
# API key: an API integration's key (Settings > Integrations > API; must not be restricted to access configurations for schedules/teams/services) or an account API key (Settings > API key management) wi
OPSGENIE_API_KEY=
# API base URL: https://api.opsgenie.com (US, default) or https://api.eu.opsgenie.com (EU instance)
# OPSGENIE_API_URL=https://api.opsgenie.com
# Web UI base for deep links, e.g. https://acme.app.opsgenie.com or https://acme.app.eu.opsgenie.com (default https://app.opsgenie.com)
# OPSGENIE_UI_URL=https://app.opsgenie.com

# --- Chronosphere (Cortex XCOR) (chronosphere) -----------------------------------------------
# Tenant subdomain, e.g. 'acme' for https://acme.chronosphere.io (the docs' ${CHRONOSPHERE_DOMAIN}); a full host such as acme.chronosphere.io is also accepted.
CHRONOSPHERE_DOMAIN=
# Service-account API token (or a temporary personal access token). Sent as 'Authorization: Bearer' and as 'API-Token' for the Config/Data APIs.
CHRONOSPHERE_API_TOKEN=

# --- Splunk AppDynamics (Controller REST API) (appdynamics) ----------------------------------
# Controller base URL WITHOUT /controller, e.g. https://acme.saas.appdynamics.com (SaaS) or https://appd.example.com:8181 (on-premises; the API is served on the Controller's primary UI/agent port).
APPD_CONTROLLER_URL=
# Controller account (tenant) name, e.g. acme (SaaS) or customer1 (most on-premises Controllers)
APPD_ACCOUNT_NAME=
# API Client name (Administration > API Clients); sent as client_id=<name>@<account>
APPD_API_CLIENT_NAME=
# API Client secret (UUID). Give the client a role with read access to the applications to investigate.
APPD_API_CLIENT_SECRET=
# Optional default business application (name or numeric id) used when a query does not filter on application
# APPD_APPLICATION=
# Optional default numeric application id for the alerting/anomaly APIs (they reject names)
# APPD_APPLICATION_ID=
# metric-data (default; every Controller version) or metric-data-v2 (the method documented for current SaaS Controllers: 1-minute data for any 24 h window within the last 8 days; older Controllers retur
# APPD_METRIC_DATA_API=metric-data

# --- Jaeger (jaeger) -------------------------------------------------------------------------
# Jaeger query HTTP base URL incl. any base path, e.g. http://jaeger-query:16686 (no trailing /api)
JAEGER_URL=
# Optional bearer token (Jaeger has no built-in auth; for an OAuth/OIDC reverse proxy in front of it)
# JAEGER_TOKEN=
# Optional basic-auth user for a reverse proxy (JAEGER_TOKEN wins)
# JAEGER_USERNAME=
# Optional basic-auth password
# JAEGER_PASSWORD=
# Set to 'true' for Jaeger 2.0-2.18 (and 1.x), which only accept snake_case api_v3 parameters (query.service_name ...). Default: camelCase (current API).
# JAEGER_LEGACY_PARAMS=false

# --- Coralogix (coralogix) -------------------------------------------------------------------
# Personal or team API key (Settings > API Keys). Use the DataQuerying preset for queries/metrics, add Alerts (alerts:ReadConfig), Incidents and CASE:* read permissions for the management tables. Sent a
CORALOGIX_API_KEY=
# Coralogix domain of the account (NOT the team hostname): us1.coralogix.com, us2.coralogix.com, us3.coralogix.com, eu1.coralogix.com, eu2.coralogix.com, ap1.coralogix.com, ap2.coralogix.com, ap3.coralo
CORALOGIX_DOMAIN=

# --- Datadog (datadog) -----------------------------------------------------------------------
# Datadog API key (Organization Settings > API Keys)
DD_API_KEY=
# Datadog application key; scope it read-only (logs_read_data, logs_read_config, metrics_read, timeseries_query, monitors_read, apm_read, rum_apps_read, events_read, incident_read, slos_read, dashboards
DD_APP_KEY=
# Datadog site of the org: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu (EU1), ap1.datadoghq.com, ap2.datadoghq.com, uk1.datadoghq.com, ddog-gov.com, us2.ddog-gov.com
# DD_SITE=datadoghq.com
# Optional Personal/Service Access Token. When set it is sent as 'Authorization: Bearer' INSTEAD of the API/application key headers (current API reference code samples use this form)
# DD_BEARER_TOKEN=
# Optional full API base URL override (e.g. a proxy); default https://api.<DD_SITE>
# DD_API_BASE_URL=
# Optional web UI base URL for deep links; default https://app.<DD_SITE> (or https://<DD_SITE> for us3/us5/ap1/ap2/uk1/us2 sites)
# DD_UI_BASE_URL=

# --- Dynatrace (Environment API v2) (dynatrace) ----------------------------------------------
# Environment API base URL WITHOUT /api/v2. SaaS: https://{env-id}.live.dynatrace.com (NOT the *.apps.dynatrace.com platform URL); Managed: https://{domain}/e/{env-id}; Environment ActiveGate: https://{
DT_ENV_URL=
# Classic access token (dt0c01.*) sent as "Authorization: Api-Token <token>". Read scopes used: metrics.read, entities.read, problems.read, events.read, logs.read, slo.read, auditLogs.read, releases.rea
DT_API_TOKEN=

# --- Dynatrace Grail (DQL) (dynatrace_grail) -------------------------------------------------
# Platform URL https://{env-id}.apps.dynatrace.com (NOT *.live.dynatrace.com), no trailing path
DT_PLATFORM_URL=
# Platform token (dt0s16.*) sent as "Authorization: Bearer <token>", with scopes storage:buckets:read plus storage:logs:read, storage:spans:read, storage:events:read, storage:metrics:read, storage:entit
DT_PLATFORM_TOKEN=

# --- Edge Delta (edgedelta) ------------------------------------------------------------------
# API token (Admin > My Organization > API Tokens) with read access to the log, metric, trace, event, monitor and pipeline resources needed. Sent as the X-ED-API-Token header.
ED_API_TOKEN=
# Organization ID (shown on the API Tokens page); every path is /v1/orgs/<ED_ORG_ID>/...
ED_ORG_ID=
# API base URL without /v1 (same variable as the Edge Delta MCP server). Override only for a dedicated/staging environment.
# ED_API_URL=https://api.edgedelta.com

# --- Elasticsearch (elasticsearch) -----------------------------------------------------------
# Base URL incl. port, e.g. https://my-deployment.es.us-central1.gcp.cloud.es.io:443 or http://localhost:9200 (no trailing slash)
ELASTICSEARCH_URL=
# Encoded API key (the base64 'encoded' value from the create-API-key response); sent as 'Authorization: ApiKey <key>'
# ELASTICSEARCH_API_KEY=
# Basic-auth user (used only when no API key is set)
# ELASTICSEARCH_USERNAME=
# Basic-auth password
# ELASTICSEARCH_PASSWORD=
# Default index pattern(s) for log search
# ELASTICSEARCH_LOGS_INDEX=logs-*,filebeat-*,logstash-*
# APM transaction/span index pattern
# ELASTICSEARCH_APM_TRACES_INDEX=traces-apm*
# APM error index pattern
# ELASTICSEARCH_APM_ERRORS_INDEX=logs-apm.error-*
# Optional Kibana URL, only used to build UI deep links
# KIBANA_URL=

# --- Kibana (kibana) -------------------------------------------------------------------------
# Kibana space id; requests are prefixed with /s/<space> unless it is 'default'
# KIBANA_SPACE=default
# Encoded Elasticsearch API key used as 'Authorization: ApiKey <key>' (falls back to ELASTICSEARCH_API_KEY)
# KIBANA_API_KEY=
# Basic-auth user (used only when no API key is set; falls back to ELASTICSEARCH_USERNAME)
# KIBANA_USERNAME=
# Basic-auth password (falls back to ELASTICSEARCH_PASSWORD)
# KIBANA_PASSWORD=

# --- Sentry (sentry) -------------------------------------------------------------------------
# Auth token (internal integration or user token) with org:read, project:read, event:read (and member:read / team:read for owners)
SENTRY_AUTH_TOKEN=
# Organization slug (or id), e.g. acme
SENTRY_ORG=
# API host without /api/0: https://sentry.io (default), https://us.sentry.io / https://de.sentry.io (region domains), or your self-hosted URL
# SENTRY_URL=https://sentry.io

# --- GitHub (github) -------------------------------------------------------------------------
# Fine-grained PAT (read-only: Contents, Metadata, Pull requests, Actions, Checks, Commit statuses, Deployments, Issues), classic PAT (repo, read:org) or a GitHub App installation token
GITHUB_TOKEN=
# API base URL. github.com: https://api.github.com (default); GitHub Enterprise Server: https://<host>/api/v3; GHE.com data residency: https://api.<subdomain>.ghe.com
# GITHUB_API_URL=https://api.github.com
# Web UI base for deep links (default https://github.com; GHES https://<host>)
# GITHUB_UI_URL=https://github.com
# Default organization (or user) login: bare repo names become GITHUB_OWNER/<repo>, and org-wide searches (merged PRs, code, commits) are scoped with org:GITHUB_OWNER. Strongly recommended.
# GITHUB_OWNER=

# --- GitLab (gitlab) -------------------------------------------------------------------------
# Personal, project or group access token with the read_api scope (read_repository is not enough for most endpoints)
GITLAB_TOKEN=
# Instance root URL without /api/v4 (default https://gitlab.com; self-managed: https://gitlab.example.com)
# GITLAB_URL=https://gitlab.com
# Default group full path (e.g. acme or acme/platform): bare project names become GITLAB_GROUP/<name>, and group-wide tables (merged MRs, projects, blob search) use it. Strongly recommended.
# GITLAB_GROUP=

# --- Google Cloud Error Reporting (gcp_error_reporting) --------------------------------------
# Project id whose errors are read.
GCP_PROJECT_ID=
# Optional service-account JSON key path; Application Default Credentials otherwise. Needs roles/errorreporting.viewer.
# GCP_CREDENTIALS_FILE=
# Optional location: unset = global (projects/P), a region such as us-central1, or '-' for all regions (projects/P/locations/-).
# GCP_ERROR_REPORTING_LOCATION=
# API endpoint override.
# GCP_ERROR_REPORTING_BASE_URL=https://clouderrorreporting.googleapis.com

# --- Google Cloud Logging (gcp_logging) ------------------------------------------------------
# API endpoint override (one of the regional endpoints listed on the API reference, Private Service Connect, proxy).
# GCP_LOGGING_BASE_URL=https://logging.googleapis.com

# --- Google Cloud Monitoring (gcp_monitoring) ------------------------------------------------
# API endpoint override (Private Service Connect, regional proxy).
# GCP_MONITORING_BASE_URL=https://monitoring.googleapis.com

# --- Google Cloud Trace (gcp_trace) ----------------------------------------------------------
# API endpoint override.
# GCP_TRACE_BASE_URL=https://cloudtrace.googleapis.com

# --- Google Cloud Managed Service for Prometheus (google_prometheus) -------------------------
# Scoping project of the metrics scope (data from every project in the scope is visible)
GMP_PROJECT_ID=
# Optional service-account JSON key path; Application Default Credentials otherwise (needs roles/monitoring.viewer)
# GMP_CREDENTIALS_FILE=

# --- Prometheus via Grafana (grafana_prometheus) ---------------------------------------------
# Grafana root URL incl. any sub-path, no trailing /api, e.g. http://localhost:3000 or https://<stack>.grafana.net
GRAFANA_URL=
# Service account token (needs datasources:query on the Prometheus data source). Optional with anonymous access
# GRAFANA_TOKEN=
# Basic-auth user (self-hosted only; used when GRAFANA_TOKEN is unset)
# GRAFANA_USERNAME=
# Basic-auth password
# GRAFANA_PASSWORD=
# Optional X-Grafana-Org-Id header
# GRAFANA_ORG_ID=
# uid of the Prometheus-type data source to proxy (often prometheus when provisioned from files; Grafana Cloud: usually grafanacloud-prom)
# GRAFANA_PROMETHEUS_UID=prometheus

# --- Grafana Loki (via Grafana datasource proxy) (grafana_loki) ------------------------------
# UID of the Loki datasource in Grafana (Connections > Data sources, or GET /api/datasources)
# GRAFANA_LOKI_UID=loki

# --- Grafana Tempo (via Grafana datasource proxy) (grafana_tempo) ----------------------------
# UID of the Tempo datasource in Grafana (Connections > Data sources, or GET /api/datasources)
# GRAFANA_TEMPO_UID=tempo

# --- Grafana Loki (loki) ---------------------------------------------------------------------
# Loki base URL without /loki/api/v1, e.g. http://loki:3100 or the Grafana Cloud Logs URL from the Cloud Portal (https://logs-prod-XXX.grafana.net)
LOKI_URL=
# Optional X-Scope-OrgID for multi-tenant Loki (several tenants separated by |). Not needed for Grafana Cloud.
# LOKI_TENANT_ID=
# Optional basic-auth user: Grafana Cloud Loki instance ID / GEL tenant
# LOKI_USERNAME=
# Optional basic-auth password: Grafana Cloud access policy token (logs:read) / GEL token
# LOKI_PASSWORD=
# Optional bearer token for a reverse proxy in front of Loki (ignored when LOKI_USERNAME is set)
# LOKI_TOKEN=

# --- Grafana Mimir / Grafana Cloud Metrics (mimir) -------------------------------------------
# Root URL of the Mimir gateway / query-frontend without any path, e.g. http://mimir-nginx.mimir.svc:80. Grafana Cloud: the Prometheus host from the stack's Prometheus 'Details' page, e.g. https://prome
MIMIR_URL=
# Mimir -http.prometheus-http-prefix. Default /prometheus (also correct for Grafana Cloud's Mimir-style URL).
# MIMIR_PROMETHEUS_PREFIX=/prometheus
# Mimir -http.alertmanager-http-prefix (default /alertmanager), appended to MIMIR_URL
# MIMIR_ALERTMANAGER_PREFIX=/alertmanager
# Optional full Alertmanager root if it is not MIMIR_URL + prefix (e.g. a separate Grafana Cloud alertmanager host)
# MIMIR_ALERTMANAGER_URL=
# Tenant sent as X-Scope-OrgID (required when -auth.multitenancy-enabled=true; omit for Grafana Cloud). Use 'tenant-a|tenant-b' for cross-tenant queries when tenant federation is enabled.
# MIMIR_TENANT_ID=
# Basic-auth user. Grafana Cloud: the metrics instance ID (the 'User' on the Prometheus Details page)
# MIMIR_USERNAME=
# Basic-auth password. Grafana Cloud: a Cloud access policy token with the metrics:read scope (glc_...)
# MIMIR_PASSWORD=
# Optional bearer token (GEM access token or an auth proxy). Ignored when MIMIR_USERNAME is set.
# MIMIR_TOKEN=

# --- Grafana Pyroscope (pyroscope) -----------------------------------------------------------
# Pyroscope query frontend base URL, e.g. http://pyroscope:4040, or the Grafana Cloud Profiles URL https://profiles-prod-NNN.grafana.net (no trailing slash)
PYROSCOPE_URL=
# Optional X-Scope-OrgID for multi-tenant Pyroscope (not used by Grafana Cloud)
# PYROSCOPE_TENANT_ID=
# Optional basic-auth user: Grafana Cloud Profiles instance ID (numeric)
# PYROSCOPE_USERNAME=
# Optional basic-auth password: Grafana Cloud access policy token with profiles:read
# PYROSCOPE_PASSWORD=
# Optional bearer token for an authenticating reverse proxy (ignored when PYROSCOPE_USERNAME is set)
# PYROSCOPE_TOKEN=

# --- Grafana Tempo (tempo) -------------------------------------------------------------------
# Tempo query-frontend URL without /api, e.g. http://tempo:3200 or https://tempo-prod-04-prod-us-east-0.grafana.net/tempo
TEMPO_URL=
# Optional X-Scope-OrgID for multi-tenant Tempo (several tenants separated by |). Not needed for Grafana Cloud.
# TEMPO_TENANT_ID=
# Optional basic-auth user: Grafana Cloud Tempo instance ID / GET tenant
# TEMPO_USERNAME=
# Optional basic-auth password: Grafana Cloud access policy token (traces:read)
# TEMPO_PASSWORD=
# Optional bearer token for a reverse proxy in front of Tempo (ignored when TEMPO_USERNAME is set)
# TEMPO_TOKEN=

# --- Honeycomb (honeycomb) -------------------------------------------------------------------
# Configuration API key (the Token) for ONE environment; sent as X-Honeycomb-Team. Needs Run Queries + Manage Queries and Columns for the query tables, Manage Triggers / Manage SLOs / Manage Markers / M
HONEYCOMB_API_KEY=
# API host: https://api.honeycomb.io (US) or https://api.eu1.honeycomb.io (EU)
# HONEYCOMB_API_URL=https://api.honeycomb.io
# UI host for links: https://ui.honeycomb.io (US) or https://ui.eu1.honeycomb.io (EU)
# HONEYCOMB_UI_URL=https://ui.honeycomb.io
# Dataset slug used when a query does not filter dataset (default __all__ = environment-wide; Classic environments need a real dataset)
# HONEYCOMB_DEFAULT_DATASET=__all__
# Column holding the service name, used by the `service` convenience filter (OpenTelemetry: service.name)
# HONEYCOMB_SERVICE_COLUMN=service.name

# --- IBM Instana Observability (instana) -----------------------------------------------------
# Tenant-unit base URL without /api, the same host as the Instana UI: https://<unit>-<tenant>.instana.io (SaaS, e.g. https://prod-acme.instana.io) or the self-hosted backend URL.
INSTANA_BASE_URL=
# API token (Settings > Security & access > API tokens), sent as 'Authorization: apiToken <token>'. Needs the application, infrastructure, events and logs read permissions used here.
INSTANA_API_TOKEN=

# --- incident.io (incidentio) ----------------------------------------------------------------
# API key from Settings > API keys (choose read/'View data' permissions; account-level or team-scoped). Sent as 'Authorization: Bearer <key>'.
INCIDENTIO_API_KEY=
# API base URL (default https://api.incident.io; there is no regional host)
# INCIDENTIO_API_URL=https://api.incident.io

# --- Kubernetes (kubernetes) -----------------------------------------------------------------
# Path to the kubeconfig file (first entry of a ':'-separated list is used), e.g. ~/.kube/config. Setting it enables this source.
KUBECONFIG=
# kubeconfig context to use (default: current-context), e.g. kind-incident-bench
# KUBE_CONTEXT=
# Alias of KUBE_CONTEXT (used when KUBE_CONTEXT is unset)
# KUBERNETES_CONTEXT=
# API server URL, e.g. https://127.0.0.1:6443 (kind) or http://127.0.0.1:8001 ('kubectl proxy'). Default: the kubeconfig cluster server (resolved before the first request)
# K8S_API_URL=
# metrics.k8s.io version served by metrics-server: v1beta1 (every metrics-server release) or v1 (stable since Kubernetes 1.37)
# K8S_METRICS_API_VERSION=v1beta1

# --- Azure Monitor Logs (Log Analytics + Application Insights) (azure_log_analytics) ---------
# Microsoft Entra tenant (directory) ID of the app registration
AZURE_TENANT_ID=
# App registration (client) ID; needs Log Analytics Reader (or Reader) on the workspace
AZURE_CLIENT_ID=
# App registration client secret
AZURE_CLIENT_SECRET=
# Workspace ID (GUID from the workspace Overview/Properties page, NOT the ARM resource id). Every table defaults to it; pass workspace_id to override.
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
# Entra authority host (sovereign clouds: https://login.chinacloudapi.cn, https://login.microsoftonline.us)
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
# Logs query API host (China: https://api.loganalytics.azure.cn, US Gov: https://api.loganalytics.us)
# AZURE_LOG_ANALYTICS_ENDPOINT=https://api.loganalytics.azure.com
# Token scope (China: https://api.loganalytics.azure.cn/.default, US Gov: https://api.loganalytics.us/.default)
# AZURE_LOG_ANALYTICS_SCOPE=https://api.loganalytics.io/.default
# Server-side query timeout sent as 'Prefer: wait=<s>' (API default 180 s, max 600 s)
# AZURE_LOG_ANALYTICS_WAIT_S=120

# --- Azure Monitor (metrics, alerts, activity log, Resource Graph, Service Health) (azure_monitor) 
# Default subscription GUID for subscription-scoped tables (override per query with subscription_id)
AZURE_SUBSCRIPTION_ID=
# Optional default region for azure_monitor_subscription_metrics, e.g. westeurope (the API requires one region per request)
# AZURE_REGION=
# ARM endpoint (China: https://management.chinacloudapi.cn, US Gov: https://management.usgovcloudapi.net)
# AZURE_RESOURCE_MANAGER_ENDPOINT=https://management.azure.com
# Token scope for ARM (China: https://management.chinacloudapi.cn/.default, US Gov: https://management.usgovcloudapi.net/.default)
# AZURE_RESOURCE_MANAGER_SCOPE=https://management.azure.com/.default
# Portal base for deep links
# AZURE_PORTAL_URL=https://portal.azure.com

# --- Azure Monitor managed Prometheus (azure_prometheus) -------------------------------------
# Query endpoint from the Azure Monitor workspace Overview page, e.g. https://k8s02-workspace-abcd.eastus.prometheus.monitor.azure.com
AZURE_PROMETHEUS_QUERY_ENDPOINT=

# --- New Relic (newrelic) --------------------------------------------------------------------
# User API key (NRAK-...). NerdGraph needs a USER key; license/ingest keys are rejected.
NEW_RELIC_API_KEY=
# Numeric account id that NRQL, alerts and change searches run against
NEW_RELIC_ACCOUNT_ID=
# Data center region: us (default), eu or jp. Picks api[.eu|.jp].newrelic.com
# NEW_RELIC_REGION=us

# --- OpenSearch (opensearch) -----------------------------------------------------------------
# Base URL incl. port, e.g. https://search-mydomain-abc.us-east-1.es.amazonaws.com or https://localhost:9200
OPENSEARCH_URL=
# Basic-auth user (security plugin internal user / FGAC master user)
# OPENSEARCH_USERNAME=
# Basic-auth password
# OPENSEARCH_PASSWORD=
# Bearer token (JWT / on-behalf-of token) used when no username is set
# OPENSEARCH_TOKEN=
# Default log index pattern(s)
# OPENSEARCH_LOGS_INDEX=logs-*,ss4o_logs-*
# Data Prepper span index pattern
# OPENSEARCH_TRACES_INDEX=otel-v1-apm-span-*
# Data Prepper service-map index pattern
# OPENSEARCH_SERVICE_MAP_INDEX=otel-v1-apm-service-map*
# Optional OpenSearch Dashboards URL for UI deep links
# OPENSEARCH_DASHBOARDS_URL=

# --- Zipkin (zipkin) -------------------------------------------------------------------------
# Zipkin server base URL without /api/v2, e.g. http://zipkin:9411
ZIPKIN_URL=
# Optional bearer token for a reverse proxy (Zipkin has no built-in auth)
# ZIPKIN_TOKEN=
# Optional basic-auth user for a reverse proxy (ZIPKIN_TOKEN wins)
# ZIPKIN_USERNAME=
# Optional basic-auth password
# ZIPKIN_PASSWORD=

# --- PagerDuty (pagerduty) -------------------------------------------------------------------
# REST API key: an account-level key (read-only is enough) or a user-level key (acts with that user's permissions). Sent as 'Authorization: Token token=<key>'.
PAGERDUTY_API_TOKEN=
# REST API base URL. US service region: https://api.pagerduty.com (default); EU service region: https://api.eu.pagerduty.com
# PAGERDUTY_API_URL=https://api.pagerduty.com
# Web UI base for deep links, e.g. https://acme.pagerduty.com or https://acme.eu.pagerduty.com (default https://app.pagerduty.com, which redirects to your subdomain after login)
# PAGERDUTY_UI_URL=https://app.pagerduty.com

# --- Prometheus Alertmanager (alertmanager) --------------------------------------------------
# Base URL before /api/v2, e.g. http://alertmanager:9093, http://mimir:8080/alertmanager or http://grafana:3000/api/alertmanager/grafana
ALERTMANAGER_URL=
# Optional bearer token (reverse proxy, or a Grafana service account token for Grafana's built-in Alertmanager)
# ALERTMANAGER_TOKEN=
# Optional basic-auth user (Grafana Cloud: Alertmanager instance id)
# ALERTMANAGER_USERNAME=
# Optional basic-auth password (Grafana Cloud: access policy token with alerts:read)
# ALERTMANAGER_PASSWORD=
# Optional X-Scope-OrgID for Mimir/Cortex multi-tenant Alertmanager
# ALERTMANAGER_TENANT_ID=

# --- Prometheus (prometheus) -----------------------------------------------------------------
# Base URL, e.g. http://prometheus:9090 (no trailing /api/v1)
PROMETHEUS_URL=
# Optional bearer token
# PROMETHEUS_TOKEN=
# Scrape interval used to expand $__rate_interval (e.g. 15s, 30s, 1m)
# PROMETHEUS_SCRAPE_INTERVAL=15s

# --- Slack (slack) ---------------------------------------------------------------------------
# Bot User OAuth token (xoxb-...). Read scopes: channels:history, groups:history, im:history, mpim:history, channels:read, groups:read, users:read (users:read.email for emails), pins:read. The bot must 
SLACK_BOT_TOKEN=
# Optional user token (xoxp-...) with search:read (search.messages) and/or search:read.public etc. (assistant.search.context). Needed only for the search tables.
# SLACK_USER_TOKEN=

# --- SigNoz (signoz) -------------------------------------------------------------------------
# Instance URL WITHOUT a trailing /api: SigNoz Cloud https://<tenant>.<region>.signoz.cloud (the URL of the SigNoz UI, not the ingest.<region>.signoz.cloud OTLP endpoint); self-hosted e.g. https://signo
SIGNOZ_URL=
# Service-account API key (Settings > Service Accounts > Keys), sent as the SIGNOZ-API-KEY header. A signoz-viewer role is enough for every table here.
SIGNOZ_API_KEY=
# Resource attribute holding the environment, used by env filters (deployment.environment, or deployment.environment.name on newer OTel semconv)
# SIGNOZ_ENV_ATTRIBUTE=deployment.environment

# --- Splunk Enterprise / Splunk Cloud Platform (splunk) --------------------------------------
# REST (management) base URL including port, e.g. https://splunk.example.com:8089 or https://<deployment>.splunkcloud.com:8089. Not the :8000 web UI and not the :8088 HEC port. No trailing slash.
SPLUNK_URL=
# Splunk authentication token (Settings > Tokens, Splunk 7.3+), sent as 'Authorization: Bearer <token>'. The user's roles decide which indexes and knowledge objects are visible.
SPLUNK_TOKEN=
# Optional Splunk Web base URL for deep links, e.g. https://splunk.example.com:8000 or https://<deployment>.splunkcloud.com
# SPLUNK_WEB_URL=
# REST namespace used to dispatch searches: 'services' (token user's default app) or 'servicesNS/<user>/<app>' (use when searches need an app's macros, lookups or eventtypes, e.g. servicesNS/nobody/my_a
# SPLUNK_SEARCH_NAMESPACE=services

# --- Splunk Observability Cloud (splunk_o11y) ------------------------------------------------
# Organization realm: us0, us1, us2, eu0, eu1, eu2, jp0, au0, sg0 ... (Settings > Organization; a wrong realm gives 401)
SPLUNK_O11Y_REALM=
# Org access token with the API authorization scope (or a user session token), sent as X-SF-TOKEN. SignalFlow /execute and SLO search need a token of a power/admin user.
SPLUNK_O11Y_TOKEN=
# Optional API base override (no trailing slash), e.g. https://api.us1.signalfx.com. Default https://api.<realm>.observability.splunkcloud.com
# SPLUNK_O11Y_API_URL=
# Optional SignalFlow stream base override. Default https://stream.<realm>.observability.splunkcloud.com
# SPLUNK_O11Y_STREAM_URL=

# --- Sumo Logic (sumologic) ------------------------------------------------------------------
# Access ID of a personal or service-account access key (Administration > Security > Access Keys). Keys with a custom scope need 'Run Log Search' (search jobs), Metrics and Alerting (monitors) read scop
SUMOLOGIC_ACCESS_ID=
# Access key secret paired with SUMOLOGIC_ACCESS_ID (HTTP basic auth)
SUMOLOGIC_ACCESS_KEY=
# Deployment (pod) of the account: us1, us2, eu, de, au, ca, ch, jp, kr, fed, esc. Read it from the browser URL: service.<pod>.sumologic.com (US1 is service.sumologic.com). A wrong pod answers HTTP 301.
# SUMOLOGIC_DEPLOYMENT=us1
# Optional explicit API base including /api, e.g. https://api.eu.sumologic.com/api (overrides SUMOLOGIC_DEPLOYMENT)
# SUMOLOGIC_API_URL=
# Optional explicit web UI base for deep links, e.g. https://service.eu.sumologic.com
# SUMOLOGIC_UI_URL=

# --- Thanos Query (thanos) -------------------------------------------------------------------
# Thanos Query or Query Frontend root, e.g. http://thanos-query.monitoring.svc:9090 (no /api/v1)
THANOS_URL=
# Optional bearer token for the auth proxy in front of Thanos (Thanos has no auth itself)
# THANOS_TOKEN=
# Optional basic-auth user for the proxy
# THANOS_USERNAME=
# Optional basic-auth password for the proxy
# THANOS_PASSWORD=
# Optional tenant id sent in the tenant header (--query.tenant-header)
# THANOS_TENANT=
# Tenant header name configured with --query.tenant-header
# THANOS_TENANT_HEADER=THANOS-TENANT

# --- VictoriaLogs (victorialogs) -------------------------------------------------------------
# VictoriaLogs (or vlselect / vmauth) root, e.g. http://victorialogs:9428 (no /select path)
VICTORIALOGS_URL=
# Optional tenant AccountID header (default tenant 0:0)
# VICTORIALOGS_ACCOUNT_ID=
# Optional tenant ProjectID header
# VICTORIALOGS_PROJECT_ID=
# Optional bearer token for the auth proxy (vmauth)
# VICTORIALOGS_TOKEN=
# Optional basic-auth user for the proxy
# VICTORIALOGS_USERNAME=
# Optional basic-auth password for the proxy
# VICTORIALOGS_PASSWORD=

# --- VictoriaMetrics (victoriametrics) -------------------------------------------------------
# Single-node: http://victoriametrics:8428. Cluster: the vmselect (or vmauth) root, e.g. http://vmselect:8481, together with VM_TENANT. If a proxy already routes to /select/<tenant>/prometheus, put that
VM_URL=
# Cluster only: tenant 'accountID' or 'accountID:projectID' (e.g. 0 or 42:1); 'multitenant' queries all tenants
# VM_TENANT=
# Optional vmalert root (http://vmalert:8880). Without it, alerts/rules go through VM_URL and need -vmalert.proxyURL on vmsingle/vmselect
# VMALERT_URL=
# Optional vmagent root (http://vmagent:8429) for scrape targets; cluster vmselect has no targets API
# VMAGENT_URL=
# Optional bearer token (vmauth / vmgateway)
# VM_TOKEN=
# Optional basic-auth user (vmauth)
# VM_USERNAME=
# Optional basic-auth password (vmauth)
# VM_PASSWORD=
